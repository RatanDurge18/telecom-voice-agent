# Pick ONE provider by setting its key. With no key the app runs in offline demo mode (keyword-rule mock).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides. Choose a small, fast model: voice needs low latency.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o-mini

# Force a provider: mock | anthropic | openai. Blank = auto (Anthropic key, else OpenAI key, else mock).
LLM_PROVIDER=
